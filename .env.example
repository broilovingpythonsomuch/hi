# Database - WAJIB PostgreSQL untuk Vercel (SQLite tidak support)
# Daftar gratis: https://neon.tech → buat project → salin connection string
DATABASE_URL="postgresql://neondb_owner:npg_ByuUo86ajNrI@ep-icy-hill-a4r5guo8-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# NextAuth - WAJIB untuk production
NEXTAUTH_SECRET="generate-dengan-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-app.vercel.app"

# Email Service (Resend) - WAJIB untuk verifikasi email
# Daftar gratis: https://resend.com → buat API key → dapatkan domain
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Your App <noreply@yourdomain.com>"

# OAuth Providers - Opsional tapi direkomendasikan
# Google OAuth: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# GitHub OAuth: https://github.com/settings/applications → New OAuth App
GITHUB_ID="your_github_client_id"
GITHUB_SECRET="your_github_client_secret"

# Facebook OAuth: https://developers.facebook.com → Apps → Create App
FACEBOOK_CLIENT_ID="your_facebook_client_id"
FACEBOOK_CLIENT_SECRET="your_facebook_client_secret"
