// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  name            String
  role            String    @default("MEMBER") // ADMIN, BENDAHARA, SEKRETARIS, MEMBER
  avatar          String?
  emailVerified   Boolean   @default(false)
  verificationToken String?
  verificationCode String?
  tokenExpiry     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  classMemberships ClassMember[]
  paymentsPaid     Payment[] @relation("PaidByUser")
  activitiesOrganized Activity[] @relation("ActivitiesOrganized")
  announcementsCreated Announcement[] @relation("AnnouncementsCreated")
  financialReports  FinancialReport[] @relation("FinancialReportCreator")
  meetingsAsSecretary MeetingMinutes[] @relation("MeetingsAsSecretary")
}

model ClassInfo {
  id          String   @id @default(cuid())
  name        String   @unique // "Kelas 7.3"
  description String?
  year        String   // "2024/2025"
  semester    String   // "Ganjil" or "Genap"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  members     ClassMember[]
  payments    Payment[]
  activities   Activity[]
  schedules   Schedule[]
  announcements Announcement[]
  financialReports FinancialReport[]
  meetingMinutes MeetingMinutes[]
}

model ClassMember {
  id        String   @id @default(cuid())
  userId    String
  classId   String
  position  String   @default("MEMBER") // KETUA_KELAS, WAKIL_KETUA, SEKRETARIS, BENDAHARA, MEMBER
  number    Int?     // Nomor absen
  status    String   @default("active") // active, inactive, moved
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  class     ClassInfo @relation(fields: [classId], references: [id], onDelete: Cascade)
  payments  Payment[]
  
  @@unique([userId, classId])
}

model Payment {
  id          String   @id @default(cuid())
  title       String   // "Iuran SPP", "Kas Kelas", "Dana Pensi"
  amount      Decimal  @db.Decimal(10,2)
  type        String   @default("REGULAR") // REGULAR, SPECIAL, VOLUNTARY
  status      String   @default("PENDING") // PENDING, PAID, OVERDUE, EXEMPT
  dueDate     DateTime
  paidDate    DateTime?
  paidBy      String?  // User ID
  paymentMethod String? // Cash, Transfer, E-Wallet
  description String?
  classId     String
  memberPaidBy String? // Member who paid (if different from payment target)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  class       ClassInfo @relation(fields: [classId], references: [id], onDelete: Cascade)
  paidByUser  User?     @relation("PaidByUser", fields: [paidBy], references: [id])
  member      ClassMember? @relation(fields: [memberPaidBy], references: [id])
}

model Activity {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   // ACADEMIC, SOCIAL, EXTRACURRICULAR, MEETING
  date        DateTime
  location    String?
  status      String   @default("PLANNED") // PLANNED, ONGOING, COMPLETED, CANCELLED
  budget      Decimal? @db.Decimal(10,2)
  actualCost  Decimal? @db.Decimal(10,2)
  classId     String
  organizerId String   // User ID
  participants String[] // Member IDs who participated
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  class       ClassInfo @relation(fields: [classId], references: [id], onDelete: Cascade)
  organizer   User      @relation("ActivitiesOrganized", fields: [organizerId], references: [id])
}

model Schedule {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   // LESSON, MEETING, EXAM, EVENT
  date        DateTime
  startTime   String
  endTime     String
  location    String?
  classId     String
  isRecurring Boolean  @default(false)
  recurringPattern String? // "weekly", "monthly"
  status      String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  class       ClassInfo @relation(fields: [classId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  type        String   @default("GENERAL") // GENERAL, URGENT, ACADEMIC, FINANCIAL
  priority    String   @default("normal") // low, normal, high, urgent
  isPinned    Boolean  @default(false)
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED
  classId     String
  authorId    String
  attachments String[] // File URLs
  tags        String[]
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  class       ClassInfo @relation(fields: [classId], references: [id], onDelete: Cascade)
  author      User      @relation("AnnouncementsCreated", fields: [authorId], references: [id])
}

model FinancialReport {
  id          String   @id @default(cuid())
  title       String
  period      String   // "Januari 2024", "Semester Ganjil 2024/2025"
  type        String   // MONTHLY, SEMESTER, YEARLY, SPECIAL
  income      Decimal  @db.Decimal(12,2) @default(0)
  expense     Decimal  @db.Decimal(12,2) @default(0)
  balance     Decimal  @db.Decimal(12,2) @default(0)
  description String?
  classId     String
  createdById String   // User ID (Bendahara)
  status      String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  createdBy   User      @relation("FinancialReportCreator", fields: [createdById], references: [id])
  class       ClassInfo @relation(fields: [classId], references: [id], onDelete: Cascade)
  details     FinancialReportDetail[]
}

model FinancialReportDetail {
  id          String   @id @default(cuid())
  reportId    String
  category    String   // "Pemasukan", "Pengeluaran"
  description String
  amount      Decimal  @db.Decimal(10,2)
  date        DateTime
  receiptUrl  String?  // Bukti transfer/struk
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  report      FinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model MeetingMinutes {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  location    String
  agenda      String[]
  decisions   String[]
  actionItems String[]
  attendees   String[] // User IDs
  classId     String
  secretaryId String   // User ID (Sekretaris)
  status      String   @default("DRAFT") // DRAFT, FINALIZED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  class       ClassInfo @relation(fields: [classId], references: [id], onDelete: Cascade)
  secretary   User      @relation("MeetingsAsSecretary", fields: [secretaryId], references: [id])
}
